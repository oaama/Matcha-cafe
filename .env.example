# Use "mongodb" to persist data in MongoDB instead of local in-memory mock data.
DATA_PROVIDER=mock
MONGODB_URI=replace-with-your-mongodb-uri
NEXTAUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace-with-a-unique-password-at-least-12-characters
